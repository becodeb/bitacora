{
  "expo": {
    "name": "Bitacora",
    "slug": "bitacora",
    "scheme": "bitacora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "ar.com.becode.bitacora",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bitacora needs access to your photos to attach one to a message.",
          "cameraPermission": "Bitacora needs access to your camera to attach a photo to a message."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Bitacora needs access to your microphone to record a voice note."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*", "image/*"],
          "disableIOS": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
