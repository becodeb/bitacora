# Copy this file to .env and fill in real values. .env is gitignored.

# Connection string for the dev Postgres started by `npm run db:up`
# (see compose.dev.yml). Matches POSTGRES_USER/PASSWORD/DB there.
DATABASE_URL=postgresql://bitacora:bitacora@localhost:55432/bitacora

# Single long bearer token the app sends on every /v1 request.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_TOKEN=change-me-to-a-long-random-token-before-use

# Port the HTTP server listens on.
PORT=3000

# Groq API key, used to transcribe voice notes (whisper-large-v3-turbo).
# Required because the pg-boss worker that transcribes them runs inside
# this same server process. Real keys live in ~/.credentials/bitacora.env
# and must never be committed.
GROQ_API_KEY=change-me-to-a-real-groq-api-key

# Voyage AI API key, used to embed entries, memories, topics and search
# queries (voyage-3.5). Required because the pg-boss embed worker runs
# inside this same server process. Real keys live in
# ~/.credentials/bitacora.env and must never be committed.
VOYAGE_API_KEY=change-me-to-a-real-voyage-api-key

# Anthropic API key, used by the agent turn (T06): the Haiku 5.5 tool
# loop and the memory dedup judge. Required because POST /v1/chat runs
# in this same server process. Real keys live in
# ~/.credentials/bitacora.env and must never be committed.
ANTHROPIC_API_KEY=change-me-to-a-real-anthropic-api-key

# How much reasoning effort Haiku 5.5 spends per agent-turn call
# (low | medium | high | xhigh | max). Optional, defaults to "low".
AGENT_EFFORT=low

# Optional. Overrides the test suite's database (see
# src/test/global-setup.ts). Without it, tests derive one automatically
# from DATABASE_URL above by appending "_test" to the database name
# (e.g. "bitacora_test") and create/migrate it on the same Postgres
# server the first time `npm test` runs. Tests never touch DATABASE_URL
# above directly.
# TEST_DATABASE_URL=postgresql://bitacora:bitacora@localhost:55432/bitacora_test

# Directory where attachment files (photos, voice notes) are stored on
# disk. Relative paths resolve against the process's working directory.
# Gitignored (see data/ in .gitignore); create it or let the server do so
# on first write.
DATA_DIR=./data
